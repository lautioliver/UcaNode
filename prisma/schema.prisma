generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoMateria {
  CURSANDO
  PARA_FINALIZAR
  REGULAR
  FINALIZADA
}

enum TipoEntrega {
  TP
  PARCIAL
  FINAL
}

enum EstadoEntrega {
  PENDIENTE
  EN_CURSO
  ENTREGADO
}

enum CategoriaLink {
  GOOGLE_DRIVE
  PLATAFORMA_UCASAL
  GITHUB
  OTRO
}

enum Modalidad {
  PRESENCIAL
  VIRTUAL
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
}

enum TipoCorrelativa {
  REGULARIZADA
  APROBADA
  PARA_RENDIR
}

enum EstadoIngesta {
  PENDIENTE
  LISTO
  ERROR
}

enum PostCategory {
  GENERAL
  APUNTE
  PREGUNTA
  EXAMEN
}

enum AttachmentType {
  PDF
  DRIVE
  EXAM
  OTRO
}

model Carrera {
  id            String        @id @default(cuid())
  slug          String        @unique
  nombre          String
  planAnio      String
  resolucion    String?
  modalidad     String?
  duracionAnios Int?
  estadoIngesta EstadoIngesta @default(LISTO)
  materias      PlanEstudio[]
  perfiles      Perfil[]
  posts         Post[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model PlanEstudio {
  id            String               @id @default(cuid())
  codigo        String
  codigoOficial String?
  nombre        String
  abreviatura   String?
  aliases       Json                 @default("[]")
  anio          Int
  semestre      Int
  tipoDictado   String?
  creditos      Int?
  carreraId     String
  carrera       Carrera              @relation(fields: [carreraId], references: [id], onDelete: Cascade)
  correlativas  CorrelatividadPlan[] @relation("MateriaCorrelativas")
  requisitoDe   CorrelatividadPlan[] @relation("RequisitoDe")
  materias      Materia[]
  posts         Post[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([carreraId, codigo])
  @@index([carreraId])
  @@index([nombre])
}

model CorrelatividadPlan {
  id          String           @id @default(cuid())
  materiaId   String
  requisitoId String
  tipo        TipoCorrelativa
  materia     PlanEstudio      @relation("MateriaCorrelativas", fields: [materiaId], references: [id], onDelete: Cascade)
  requisito   PlanEstudio      @relation("RequisitoDe", fields: [requisitoId], references: [id], onDelete: Cascade)

  @@unique([materiaId, requisitoId, tipo])
}

model Perfil {
  id                      String                   @id @default(cuid())
  nombre                  String
  emailUcasal             String?                  @unique
  emailVerifiedAt         DateTime?
  anioIngreso             Int
  legajo                  String?
  password                String?
  carreraId               String?
  fantasma                Boolean                  @default(false)
  carrera                 Carrera?                 @relation(fields: [carreraId], references: [id])
  materias                Materia[]
  links                   LinkExterno[]
  emailVerificationTokens EmailVerificationToken[]
  posts                   Post[]
  comments                Comment[]
  postVotes               PostVote[]
  commentVotes            CommentVote[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  perfilId  String
  perfil    Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([perfilId])
}

model Materia {
  id            String         @id @default(cuid())
  nombre        String
  codigo        String?
  estado        EstadoMateria  @default(CURSANDO)
  cuatrimestre  Int?
  anio          Int?
  profesor      String?
  correlativas  String?
  notas         String?
  promocional   Boolean        @default(false)
  semestre      String?
  dia           DiaSemana?
  planEstudioId String?
  perfilId      String
  planEstudio   PlanEstudio?   @relation(fields: [planEstudioId], references: [id], onDelete: SetNull)
  perfil        Perfil         @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  entregas      Entrega[]
  horarios      Horario[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([perfilId, codigo])
  @@index([estado])
  @@index([nombre])
  @@index([perfilId])
}

model Entrega {
  id                String         @id @default(cuid())
  titulo            String
  tipo              TipoEntrega
  fecha             DateTime
  estado            EstadoEntrega  @default(PENDIENTE)
  nota              Float?
  fechaInicio       DateTime?
  fechaCompletada   DateTime?
  recurso           String?
  prioridad         String?
  materiaId         String
  materia           Materia        @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([fecha])
  @@index([materiaId])
  @@index([estado])
}

model Horario {
  id            String     @id @default(cuid())
  dia           DiaSemana
  horaInicio    String
  horaFin       String
  modalidad     Modalidad  @default(PRESENCIAL)
  aulaLink      String?
  materiaId     String
  materia       Materia    @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model LinkExterno {
  id            String         @id @default(cuid())
  nombre        String
  url           String
  categoria     CategoriaLink  @default(OTRO)
  favorito      Boolean        @default(false)
  perfilId      String
  perfil        Perfil         @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([perfilId])
}

model Post {
  id            String           @id @default(cuid())
  title         String
  content       String           @db.Text
  category      PostCategory     @default(GENERAL)
  tags          String[]         @default([])

  perfilId      String
  perfil        Perfil           @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  carreraId     String?
  carrera       Carrera?         @relation(fields: [carreraId], references: [id])

  planEstudioId String?
  planEstudio   PlanEstudio?     @relation(fields: [planEstudioId], references: [id])

  attachments   PostAttachment[]
  comments      Comment[]
  votes         PostVote[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([perfilId])
  @@index([carreraId])
  @@index([planEstudioId])
  @@index([createdAt])
}

model PostAttachment {
  id     String         @id @default(cuid())
  name   String
  url    String
  type   AttachmentType @default(OTRO)
  postId String
  post   Post           @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Comment {
  id       String        @id @default(cuid())
  content  String        @db.Text

  perfilId String
  perfil   Perfil        @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  postId   String
  post     Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[]     @relation("CommentReplies")

  votes    CommentVote[]

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([postId])
  @@index([perfilId])
  @@index([parentId])
}

model PostVote {
  id       String @id @default(cuid())
  type     Int
  perfilId String
  perfil   Perfil @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([perfilId, postId])
}

model CommentVote {
  id        String  @id @default(cuid())
  type      Int
  perfilId  String
  perfil    Perfil  @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([perfilId, commentId])
}
